#!/usr/bin/env bash
set -euo pipefail

ssh_dir="$HOME/.ssh"
key_file="$ssh_dir/id_ed25519"
public_key="$key_file.pub"
title="$(hostname -s)-$(date -u +%Y-%m-%d)"

install -d -m 700 "$ssh_dir"

if [[ ! -e "$key_file" ]]; then
    ssh-keygen -q -t ed25519 -N '' -C "$USER@$title" -f "$key_file"
fi

if [[ ! -f "$public_key" ]]; then
    if ! ssh-keygen -y -f "$key_file" > "$public_key"; then
        rm -f "$public_key"
        printf 'Cannot derive %s; check its passphrase and rerun chezmoi apply.\n' "$public_key" >&2
        exit 0
    fi
fi

chmod 600 "$key_file"
chmod 644 "$public_key"
key_blob="$(awk '{print $1 " " $2}' "$public_key")"

github_authenticated=false
gitlab_authenticated=false
if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    github_authenticated=true
    if ! gh ssh-key list 2>/dev/null | grep -Fq "$key_blob"; then
        gh ssh-key add "$public_key" --title "$title" --type authentication \
            || printf 'Could not register %s with GitHub; add %s manually.\n' "$public_key" "$public_key" >&2
    fi
fi

if command -v glab >/dev/null 2>&1 && glab auth status >/dev/null 2>&1; then
    gitlab_authenticated=true
    if ! glab ssh-key list 2>/dev/null | grep -Fq "$key_blob"; then
        glab ssh-key add "$public_key" --title "$title" --usage-type auth \
            || printf 'Could not register %s with GitLab; add %s manually.\n' "$public_key" "$public_key" >&2
    fi
fi

printf 'SSH key ready: %s\n' "$public_key"
if [[ "$github_authenticated" == false && "$gitlab_authenticated" == false ]]; then
    printf 'Register it with GitHub/GitLab after authenticating gh/glab.\n' >&2
fi
