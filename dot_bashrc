# User paths must precede system paths.
export PATH="$HOME/.local/bin:$HOME/.config/emacs/bin:$PATH"

# k3d needs the host socket path as well as Podman's Docker API endpoint.
export DOCKER_HOST="${DOCKER_HOST:-unix://${XDG_RUNTIME_DIR:-/run/user/$UID}/podman/podman.sock}"
if [[ "$DOCKER_HOST" == unix://* ]]; then
    export DOCKER_SOCK="${DOCKER_HOST#unix://}"
fi

case $- in
    *i*) ;;
    *) return ;;
esac

if [[ -f /etc/bashrc ]]; then
    source /etc/bashrc
fi

if command -v mise >/dev/null 2>&1; then
    eval "$(mise activate bash)"
fi

if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init bash)"
fi

alias ls='eza'
alias ll='eza -lah'
alias la='eza -a'

HISTCONTROL=ignoreboth:erasedups
HISTSIZE=10000
HISTFILESIZE=20000
shopt -s histappend
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init bash)"
fi
alias k='kubectl'

# Terminal Emacs frame on the systemd user daemon (emacs.service); starts one if it isn't running.
alias e='emacsclient -t -a ""'
